<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="TestNG Parameters Suite" verbose="2">

    <!--
    <parameter name="val1" value="60"/>
    <parameter name="val2" value="20"/>  -->

    <test name="Params1">
        <parameter name="val1" value="150"/>
        <parameter name="val2" value="50"/>      <!-- method overriding -->
        <classes>
            <class name="testNG.parameter.ParameterTest01"/>
        </classes>
    </test>

    <test name="Params2">
<!-- values assign using Optional annotation in the ParameterTest02 class -->
        <classes>
            <class name="testNG.parameter.ParameterTest02"/>
        </classes>
    </test>

    <test name="Params3">
        <parameter name="browser" value="Chrome"/>

        <classes>
            <class name="testNG.parameter.ParameterTest03"/>
        </classes>
    </test>
</suite>